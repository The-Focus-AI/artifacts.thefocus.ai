{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "api/**/*.ts",
    "tests/**/*.ts",
    "scripts/review-table.ts"
  ],
  "exclude": ["dist", "node_modules", ".pi", ".agents", ".sandcastle"]
}
