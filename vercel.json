{
  "functions": {
    "api/root.ts": {
      "includeFiles": "public/**"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""
        },
        {
          "key": "Content-Signal",
          "value": "ai-train=no, search=yes, ai-input=yes"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Content-Signal",
          "value": "ai-train=no, search=yes, ai-input=yes"
        }
      ]
    },
    {
      "source": "/landing.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Content-Signal",
          "value": "ai-train=no, search=yes, ai-input=yes"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/root"
    },
    {
      "source": "/index.md",
      "destination": "/landing.md"
    },
    {
      "source": "/login/callback",
      "destination": "/api/login/callback"
    },
    {
      "source": "/logout",
      "destination": "/api/logout"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/a/:opaque",
      "destination": "/api/a/:opaque"
    },
    {
      "source": "/a/:opaque/",
      "destination": "/api/a/:opaque"
    },
    {
      "source": "/a/:opaque/:path*",
      "destination": "/api/a/:opaque?path=:path*"
    },
    {
      "source": "/d/:opaque",
      "destination": "/api/d/:opaque"
    },
    {
      "source": "/d/:opaque/",
      "destination": "/api/d/:opaque"
    },
    {
      "source": "/d/:opaque/:path*",
      "destination": "/api/d/:opaque?path=:path*"
    },
    {
      "source": "/r/:review",
      "destination": "/review.html"
    },
    {
      "source": "/r/:review/",
      "destination": "/review.html"
    }
  ]
}
