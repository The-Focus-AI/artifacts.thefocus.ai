{
  "rewrites": [
    {
      "source": "/login/callback",
      "destination": "/api/login/callback"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/a/:opaque",
      "destination": "/api/a/:opaque"
    },
    {
      "source": "/a/:opaque/:path*",
      "destination": "/api/a/:opaque/:path*"
    }
  ]
}
